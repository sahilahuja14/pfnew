# Portfolio Backend Configuration
# Copy this file to .env and fill in your actual credentials

# Gmail SMTP Configuration
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-app-specific-password
RECIPIENT_EMAIL=where-to-send-contact-forms@gmail.com

# Server Configuration
PORT=5000
NODE_ENV=development

# To get Gmail App Password:
# 1. Enable 2FA on your Google account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your device)
# 4. Copy the 16-character password generated
# 5. Paste it in EMAIL_PASSWORD above (remove spaces)
