+
+/* ── Mobile performance pass ──
+   Backdrop-filter's blur radius directly drives how expensive it is for the
+   browser to composite: this stylesheet has 80+ backdrop-filter
+   declarations, every one of which now routes its radius through
+   --glass-blur (falling back to its original per-element value on desktop).
+   Dropping that one variable on narrow viewports cuts the compositing cost
+   of every glass surface on the page at once, without having to touch each
+   selector individually or change how anything looks structurally. 6px
+   still reads as "frosted" at the sizes these panels render on mobile;
+   go lower (or to 0 to disable blur outright and fall back to the flat
+   dashed-border look) if it still isn't smooth enough on your test device. */
+@media (max-width: 768px) {
+  :root {
+    --glass-blur: 6px;
+  }
+
+  /* This badge runs an 8s infinite box-shadow animation, which forces a
+     repaint every frame forever (not just while scrolling), stacked on
+     top of a live blur layer. It's purely decorative, so switch it off
+     on mobile rather than paying for it continuously. */
+  .hero-badge {
+    animation: none;
+  }
+}
+
+/* content-visibility lets the browser skip layout/paint/compositing work
+   entirely for sections that are off-screen, only doing that work once a
+   section is about to scroll into view. With this many glass/blur surfaces
+   spread across About/Experience/Skills/Projects/Contact, this means the
+   browser is only ever compositing the blur layers actually near the
+   viewport instead of all of them at once. contain-intrinsic-size reserves
+   approximate space up front so the page doesn't jump as each section
+   "wakes up". If IntersectionObserver-based reveals in any section stop
+   firing correctly after this, drop content-visibility on that one
+   section's id first to isolate it. */
+#experience,
+#skills,
+#projects,
+#contact {
+  content-visibility: auto;
+  contain-intrinsic-size: auto 900px;
 }
