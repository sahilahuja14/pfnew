{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Sahil Ahuja's Portfolio Website - React + Vite Frontend, Node.js + Express Backend",
  "private": true,
  "scripts": {
    "client:install": "cd client && npm install",
    "server:install": "cd server && npm install",
    "install-all": "npm run client:install && npm run server:install",
