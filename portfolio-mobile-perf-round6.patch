@@ -167,7 +167,14 @@ a {
 
 @keyframes cardRevealIn {
   from {
-    opacity: 0;
+    /* opacity 0.001, not 0 — the resting-state fix on [data-card-reveal]
+       elsewhere in this file only helps while the element is sitting
+       idle. The instant this animation starts, its own `from` value
+       takes over and snaps opacity back to whatever is written here,
+       re-triggering the same cold-start this file is trying to avoid.
+       Both the resting state AND every reveal-in keyframe's `from` need
