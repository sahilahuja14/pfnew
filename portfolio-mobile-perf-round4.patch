 #contact {
   content-visibility: auto;
   contain-intrinsic-size: auto 900px;
+}
+
+/* Set by the IntersectionObserver in App.jsx once a section is ~600px
+   from entering the viewport. Switching to `visible` cancels the
+   content-visibility skip early, so the section (and its backdrop-filter
+   layers) get composited while still off-screen instead of exactly when
+   you scroll to them. */
+#experience.cv-primed,
+#skills.cv-primed,
+#projects.cv-primed,
+#contact.cv-primed {
+  content-visibility: visible;
 }
